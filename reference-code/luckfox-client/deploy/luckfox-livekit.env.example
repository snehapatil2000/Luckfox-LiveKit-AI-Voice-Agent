LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=your_livekit_api_key
LIVEKIT_API_SECRET=your_livekit_api_secret
LIVEKIT_AGENT_NAME=my-agent
CAPTURE_DEVICE=plughw:0,0
PLAYBACK_DEVICE=hw:0,0

# MIC1 is opened once by the client. In standby it feeds PocketSphinx locally;
# after the beep it publishes the same capture stream to LiveKit. Do not open a
# second recorder for wake-word detection.
WAKE_WORD=edison
WAKEWORD_THRESHOLD=1e-5
WAKEWORD_BINARY=/opt/luckfox-wakeword/luckfox-wakeword
WAKEWORD_MODEL=/opt/luckfox-wakeword/en-us/en-us
WAKEWORD_DICTIONARY=/opt/luckfox-wakeword/en-us/cmudict-en-us.dict

# A20 GeckoLink gateway used by the voice-automation tools. The client resolves
# the fixed gateway MAC 30:1F:9A:D1:45:49, so no gateway IP is configured.
# Use a dedicated low-privilege account. The client logs in again automatically
# when its short-lived access token expires. A static GECKOLINK_TOKEN also works.
GECKOLINK_USERNAME=voice_agent
GECKOLINK_PASSWORD=replace_with_a_strong_password
# GECKOLINK_TOKEN=your_geckolink_bearer_token
