LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=your_livekit_api_key
LIVEKIT_API_SECRET=your_livekit_api_secret
LIVEKIT_AGENT_NAME=my-agent
CAPTURE_DEVICE=hw:0,0
PLAYBACK_DEVICE=hw:0,0

# A20 GeckoLink gateway used by the voice-automation tools.
# Replace A20_LAN_IP with the A20 board's actual address.
# Use a dedicated low-privilege account. The client logs in again automatically
# when its short-lived access token expires. A static GECKOLINK_TOKEN also works.
GECKOLINK_URL=http://A20_LAN_IP:8889
GECKOLINK_USERNAME=voice_agent
GECKOLINK_PASSWORD=replace_with_a_strong_password
# GECKOLINK_TOKEN=your_geckolink_bearer_token
